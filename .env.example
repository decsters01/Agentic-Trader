# =============================================================================
# AUTONOMOUS TRADING AGENT - ENVIRONMENT CONFIGURATION
# =============================================================================
#
# Decisões: apenas indicadores e regras (ver indicator_signals.py e config.py).
# Este projeto não usa LLM nem chaves OpenAI/Groq/Cerebras.
#
# =============================================================================

# -----------------------------------------------------------------------------
# OPENALGO CONFIGURATION (Required)
# -----------------------------------------------------------------------------

OPENALGO_API_KEY=your-openalgo-api-key-here
OPENALGO_HOST=http://127.0.0.1:5000

# -----------------------------------------------------------------------------
# UV PACKAGE MANAGER CONFIGURATION (Optional)
# -----------------------------------------------------------------------------

# Suppress hardlink warning if on different filesystems
# UV_LINK_MODE=copy

# -----------------------------------------------------------------------------
# MEMORY CONFIGURATION (Optional)
# -----------------------------------------------------------------------------

# MAX_MEMORY_ITEMS=10

# -----------------------------------------------------------------------------
# TRADING CONFIGURATION
# -----------------------------------------------------------------------------

# Limiares para decide_action (após score 0..1 dos indicadores)
# SENTIMENT_THRESHOLD_BUY=0.6
# SENTIMENT_THRESHOLD_SELL=0.4

# Trading symbols (comma-separated). Default em config.py: ICICIBANK,WIPRO
# TRADING_SYMBOLS=ICICIBANK,WIPRO

# Max investment per trade (in Rs.)
# MAX_INVESTMENT_PER_TRADE=10000

# Daily stop-loss (in Rs.). Default em config.py: -5000
# DAILY_STOP_LOSS=-5000

# Max trades per symbol per day
# MAX_TRADES_PER_SYMBOL=5

# =============================================================================
